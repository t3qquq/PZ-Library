<?xml version="1.0" encoding="utf-8"?>
<animNode x_extends="GSAReaction.xml">
	<m_Name>GSAReactionFall</m_Name>
	<m_AnimName>Zombie_GunStockAttackAnim</m_AnimName>
	<m_deferredBoneAxis>Y</m_deferredBoneAxis>
	<m_Looped>false</m_Looped>
	<m_SpeedScale>1.28</m_SpeedScale>

	<m_Conditions>
		<m_Name>GunStockAttack_HitByRifle</m_Name>
		<m_Type>BOOL</m_Type>
		<m_BoolValue>true</m_BoolValue>
	</m_Conditions>	

	<m_Conditions>
		<m_Name>bKnockedDown</m_Name>
		<m_Type>BOOL</m_Type>
		<m_BoolValue>true</m_BoolValue>
	</m_Conditions>

	<m_Conditions>
		<m_Name>GunStockAttack_ZombieGetVariable</m_Name>
		<m_Type>BOOL</m_Type>
		<m_BoolValue>true</m_BoolValue>
	</m_Conditions>

	<m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_Time>End</m_Time>
		<m_ParameterValue>GunStockAttack_ZombieGetVariable=false</m_ParameterValue>
	</m_Events>

	<m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_Time>End</m_Time>
		<m_ParameterValue>GunStockAttack_HitByRifle=false</m_ParameterValue>
	</m_Events>	

	<m_Events>
		<m_EventName>FallOnFront</m_EventName>
		<m_Time>Start</m_Time>
		<m_ParameterValue>false</m_ParameterValue>
	</m_Events>

	<m_Events>
		<m_EventName>PlaySound</m_EventName>
		<m_TimePc>0.4</m_TimePc>
		<m_ParameterValue>BodyHitGround</m_ParameterValue>
	</m_Events>
</animNode>
